version: 4
title: How Bygone learned to review a branch
sourceUrl: https://github.com/davidmashburn/bygone/commit/75b6d7c0303124ec314aa790d6b808c4a9d9ea0e
range:
  base: 292fe9248c5c49f762489dc688296fc100d120bc
  head: 75b6d7c0303124ec314aa790d6b808c4a9d9ea0e

anchors:
  choose-merge-base:
    file: src/gitComparison.ts
    revision: head
    contains: "    const mergeBaseOids = runGit(['merge-base', '--all', baseOid, headOid], repoRoot)"
  describe-range:
    file: src/gitComparison.ts
    revision: head
    contains: "        changedPaths: listChangedPaths(repoRoot, mergeBaseOid, headOid, runGit),"
  materialize-boundary:
    file: src/gitComparison.ts
    revision: head
    contains: "export function materializeBranchReviewTrees("
  open-review-surface:
    file: src/fileComparator.ts
    revision: head
    contains: "            materializeBranchReviewTrees(range, leftRoot, rightRoot);"
  prove-merge-base:
    file: test/runTests.js
    revision: head
    contains: "    assert.equal(range.mergeBaseOid, baseOid);"

connections:
  range-to-snapshot:
    from: choose-merge-base
    to: materialize-boundary
    label: The selected historical boundary determines the two trees a reviewer sees.
  snapshot-to-surface:
    from: materialize-boundary
    to: open-review-surface
    label: The Git model is converted into the ordinary directory comparison surface.
  semantics-to-proof:
    from: choose-merge-base
    to: prove-merge-base
    label: A repository fixture locks the branch comparison to merge-base semantics.

chapters:
  - id: branch-to-review
    title: A branch becomes a review
    scenes:
      - id: review-pipeline
        title: From Git history to a visual workspace
        summary: Follow the branch-review feature from its historical boundary to the reusable comparison surface and the test that fixes its semantics.
        bullets:
          - Resolve the range before materializing files for the comparison.
          - Keep Git-specific preparation at the temporary-tree handoff.
          - Read the fixture as a proof of range semantics, separate from the renderer.
        tags: [git, architecture, dogfood]
        takeaway: Bygone reviews its own history using the same boundary it introduced in this commit.
        steps:
          - id: establish-boundary
            title: Establish the historical boundary
            body: Using the unique merge base makes the review start at branch divergence; the resolver rejects multiple merge bases instead of silently choosing one.
            focus: choose-merge-base
          - id: make-range-portable
            title: Describe the review as data
            body: BranchReviewRange carries changed paths and commits once, so the renderer can consume prepared history rather than rediscovering Git state.
            focus: describe-range
          - id: turn-history-into-files
            title: Materialize two review trees
            body: Materializing only changed paths creates the two snapshots the diff can read; the temporary roots add setup and cleanup around the read-only comparison.
            focus: materialize-boundary
            connection: range-to-snapshot
          - id: reuse-the-diff-surface
            title: Reuse directory comparison
            body: Passing the roots to compareDirectories keeps branch review on the established directory workflow, so navigation and drill-down are reused instead of implemented in a branch-specific renderer.
            focus: open-review-surface
            connection: snapshot-to-surface
          - id: lock-the-semantics
            title: Prove the range starts at divergence
            body: The fixture asserts the merge base, changed paths, and commit count; renderer behavior needs separate checks.
            focus: prove-merge-base
            connection: semantics-to-proof
