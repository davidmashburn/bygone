{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidmashburn/bygone/schemas/change-tour-source.schema.json",
  "title": "Bygone Change Tour Source",
  "description": "An agent- or human-authored, evidence-linked narrative compiled by Bygone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "anchors", "connections", "chapters"],
  "properties": {
    "version": { "const": 1 },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "windowTitle": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Optional native window title for the tour presenter. Use a short label such as a pull request number when multiple tours may be open."
    },
    "sourceUrl": { "type": "string", "minLength": 1 },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head"],
      "properties": {
        "base": { "$ref": "#/$defs/nonEmptyString" },
        "head": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclusions"],
      "properties": {
        "exclusions": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverageExclusion" }
        }
      }
    },
    "anchors": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/anchor" }
    },
    "connections": {
      "oneOf": [
        {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/connectionWithoutId" }
        },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/connectionWithId" }
        }
      ]
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chapter" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "revision", "contains"],
      "properties": {
        "file": { "$ref": "#/$defs/nonEmptyString" },
        "revision": { "enum": ["base", "head"] },
        "contains": { "$ref": "#/$defs/nonEmptyString" },
        "occurrence": { "type": "integer", "minimum": 1 }
      }
    },
    "connectionWithoutId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "label"],
      "properties": {
        "from": { "$ref": "#/$defs/nonEmptyString" },
        "to": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "connectionWithId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "from": { "$ref": "#/$defs/nonEmptyString" },
        "to": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "narrative": {
      "type": "object",
      "required": ["summary", "bullets", "tags", "takeaway"],
      "properties": {
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "bullets": { "$ref": "#/$defs/stringArray" },
        "tags": { "$ref": "#/$defs/stringArray" },
        "takeaway": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "body", "focus"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "body": { "$ref": "#/$defs/nonEmptyString" },
        "focus": { "$ref": "#/$defs/nonEmptyString" },
        "connection": { "$ref": "#/$defs/nonEmptyString" },
        "depth": { "enum": ["mentioned", "explained", "contextualized"] }
      }
    },
    "coverageExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "hunks": { "$ref": "#/$defs/stringArray" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "scene": {
      "allOf": [
        { "$ref": "#/$defs/narrative" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "summary", "bullets", "tags", "takeaway", "steps"],
          "properties": {
            "id": { "$ref": "#/$defs/nonEmptyString" },
            "title": { "$ref": "#/$defs/nonEmptyString" },
            "summary": { "$ref": "#/$defs/nonEmptyString" },
            "bullets": { "$ref": "#/$defs/stringArray" },
            "tags": { "$ref": "#/$defs/stringArray" },
            "takeaway": { "$ref": "#/$defs/nonEmptyString" },
            "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
          }
        }
      ]
    },
    "stackEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "ref": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "stackStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "body", "file", "pair"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "body": { "$ref": "#/$defs/nonEmptyString" },
        "file": { "$ref": "#/$defs/nonEmptyString" },
        "pair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "side": { "enum": ["left", "right"] },
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "stackedScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "summary", "bullets", "tags", "takeaway", "stack", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "stacked-diff" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "bullets": { "$ref": "#/$defs/stringArray" },
        "tags": { "$ref": "#/$defs/stringArray" },
        "takeaway": { "$ref": "#/$defs/nonEmptyString" },
        "stack": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "$ref": "#/$defs/stackEntry" } },
        "files": { "$ref": "#/$defs/stringArray" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stackStep" } }
      }
    },
    "deconstructedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "hunks"],
      "properties": {
        "file": { "$ref": "#/$defs/nonEmptyString" },
        "hunks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "deconstructedExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "reason"],
      "properties": {
        "file": { "$ref": "#/$defs/nonEmptyString" },
        "hunks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "deconstructedStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "narration", "changes"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "narration": { "$ref": "#/$defs/nonEmptyString" },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deconstructedChange" }
        }
      }
    },
    "deconstructedScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "summary", "bullets", "tags", "takeaway", "stages"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "deconstructed-diff" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "bullets": { "$ref": "#/$defs/stringArray" },
        "tags": { "$ref": "#/$defs/stringArray" },
        "takeaway": { "$ref": "#/$defs/nonEmptyString" },
        "base": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/deconstructedStage" }
        },
        "exclusions": {
          "type": "array",
          "items": { "$ref": "#/$defs/deconstructedExclusion" }
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "scenes"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/scene" },
              { "$ref": "#/$defs/stackedScene" },
              { "$ref": "#/$defs/deconstructedScene" }
            ]
          }
        }
      }
    }
  }
}
