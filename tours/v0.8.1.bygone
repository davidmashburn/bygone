version: 1
title: Bygone 0.8.1 — native editing comfort and release polish
sourceUrl: https://github.com/davidmashburn/bygone/compare/f32a046...88bb37b
range:
  base: f32a046767147312bfe78ec960e55972f2ef134b
  head: 88bb37b1a94e088f960a7bc9805b48faec3b1774

anchors:
  changelog-editor-comfort:
    file: CHANGELOG.md
    revision: head
    contains: |-
      - Added familiar multi-cursor, selection, line, comment, indentation, folding, drag-and-drop, and context-menu editing across Bygone's two-way and multi-panel editors
      - Added source-aware Monaco models and bounded syntax support while preserving comparison state, model disposal, tour rendering, and connector geometry
      - Returned `Cmd/Ctrl+Alt+Up/Down` to Monaco's cursor controls and added change navigation through `F7`, `Shift+F7`, and simultaneous `Cmd/Ctrl+Shift+Up/Down`
  monaco-contributions:
    file: media/webview-entry.js
    revision: head
    contains: import 'monaco-editor/esm/vs/editor/contrib/multicursor/browser/multicursor.js';
  folding-contribution:
    file: media/webview-entry.js
    revision: head
    contains: import 'monaco-editor/esm/vs/editor/contrib/folding/browser/folding.js';
  python-language:
    file: media/webview-entry.js
    revision: head
    contains: import 'monaco-editor/esm/vs/basic-languages/python/python.contribution.js';
  language-inference:
    file: src/languageSupport.ts
    revision: head
    contains: |-
      export function inferLanguageId(filePath: string | undefined): string {
          if (!filePath) return 'plaintext';
          const parts = filePath.split(/[\\/]/);
          const name = (parts[parts.length - 1] ?? '').toLocaleLowerCase();
  language-normalization:
    file: src/languageSupport.ts
    revision: head
    contains: |-
      export function normalizeLanguageId(languageId: string | undefined, filePath?: string): string {
          if (languageId && SUPPORTED_LANGUAGE_IDS.has(languageId)) return languageId;
          return inferLanguageId(filePath);
      }
  resolve-panel-language:
    file: src/diffViewProvider.ts
    revision: head
    contains: |-
      languageId: file.languageId ?? normalizeLanguageId(undefined, file.uri.path),
  owned-monaco-model:
    file: media/script.js
    revision: head
    contains: |-
      function createOwnedModel(content, languageId) {
          modelIdentityCounter += 1;
          return monacoInstance.editor.createModel(
              content,
              languageId,
              monacoInstance.Uri.parse(`bygone://model/${modelIdentityCounter}`)
          );
      }
  editor-comfort-options:
    file: media/script.js
    revision: head
    contains: "        multiCursorPaste: 'spread',"
  folding-connectors:
    file: media/script.js
    revision: head
    contains: "    editor.onDidChangeHiddenAreas(() => {"
  change-navigation-keys:
    file: media/script.js
    revision: head
    contains: "    editor.addCommand(monacoInstance.KeyCode.F7, () => navigateDiff(1));"
  editor-action-bridge:
    file: media/script.js
    revision: head
    contains: "    if (message.type === 'editorAction' && typeof message.actionId === 'string') {"
  selection-menu:
    file: standalone/main.js
    revision: head
    contains: "                    label: 'Selection',"
  lines-menu:
    file: standalone/main.js
    revision: head
    contains: "                    label: 'Lines',"
  editor-comfort-proof:
    file: test/runTests.js
    revision: head
    contains: "    assert.match(rendererSource, /KeyCode\\.F7, \\(\\) => navigateDiff\\(1\\)/);"
  readme-platform-split:
    file: README.md
    revision: head
    contains: |-
      Packaged macOS builds register `.bygone` with the desktop app, so Finder can open a presentation directly. Windows and Linux builds currently require opening the file through Bygone or the `bygone` command; they do not install an operating-system file association.
  npm-cli-mapping:
    file: scripts/package-npm.mjs
    revision: head
    contains: |-
      bin: {
              bygone: 'bin/bygone.js'
          },
  tooltip-proof:
    file: test/runTests.js
    revision: head
    contains: "assert.match(source, /title=\"Previous difference \\(Shift\\+F7 or Cmd\\/Ctrl\\+Shift\\+Up\\)\"/);"

connections:
  contributions-to-editor:
    from: monaco-contributions
    to: folding-contribution
    label: Bundled Monaco contributions unlock folding and the rest of the native editing surface.
  language-to-models:
    from: language-normalization
    to: owned-monaco-model
    label: Normalized language ids feed owned Monaco models instead of a single plaintext surface.
  models-to-host:
    from: owned-monaco-model
    to: resolve-panel-language
    label: The VS Code host resolves language metadata before panels reach the renderer.
  folding-to-connectors:
    from: folding-contribution
    to: folding-connectors
    label: Folding changes schedule connector redraws so diff links stay aligned with visible code.
  menus-to-bridge:
    from: selection-menu
    to: editor-action-bridge
    label: Standalone Selection and Lines menus dispatch allowlisted Monaco actions through the renderer bridge.
  comfort-to-proof:
    from: change-navigation-keys
    to: editor-comfort-proof
    label: Regression tests lock model ownership, bundled contributions, menus, and F7 navigation.
  keys-to-tooltips:
    from: change-navigation-keys
    to: tooltip-proof
    label: Toolbar tooltips advertise the new change-navigation shortcuts and stop claiming Alt-arrow diff navigation.

chapters:
  - id: editor-comfort
    title: Embedded editors gain native editing comfort
    scenes:
      - id: native-monaco-editing
        title: Bring familiar Monaco editing into comparisons
        summary: 0.8.1 bundles the Monaco contributions, language inference, owned models, and menus needed for multi-cursor editing, folding, and F7 change navigation without breaking comparison state or connector geometry.
        bullets:
          - Monaco contributions for multi-cursor, folding, indentation, and basic languages ship in the webview bundle.
          - Source-aware models infer language ids from file paths and VS Code documents.
          - Standalone Selection and Lines menus dispatch allowlisted native actions.
          - F7 and Cmd/Ctrl+Shift+Up/Down navigate semantic changes while Alt+Up/Down return to Monaco.
        tags: [editor, monaco, navigation, syntax]
        takeaway: Bygone comparisons now feel like real editors while preserving diff navigation and connector rendering.
        steps:
          - id: state-release-scope
            title: Read the 0.8.1 release scope
            body: The changelog frames 0.8.1 as native editing comfort, source-aware syntax, restored Monaco cursor shortcuts, and standalone editor menus.
            focus: changelog-editor-comfort
          - id: bundle-monaco-contributions
            title: Bundle native Monaco contributions
            body: The webview entrypoint imports multi-cursor, folding, indentation, drag-and-drop, and bounded basic-language contributions.
            focus: monaco-contributions
            connection: contributions-to-editor
          - id: bundle-folding
            title: Enable folding in the bundle
            body: Folding support ships alongside the other editor contributions instead of relying on the bare Monaco API surface.
            focus: folding-contribution
          - id: bundle-python-syntax
            title: Add bounded language contributions
            body: Basic-language contributions such as Python extend syntax highlighting without pulling in the full Monaco language catalog.
            focus: python-language
          - id: infer-language-ids
            title: Infer language ids from paths
            body: A new language support module maps common extensions, including `.bygone`, to bounded Monaco language ids with a plaintext fallback.
            focus: language-inference
          - id: normalize-host-languages
            title: Normalize languages at the host boundary
            body: The VS Code provider resolves document language ids and falls back to path inference before sending panel metadata to the renderer.
            focus: resolve-panel-language
            connection: language-to-models
          - id: create-owned-models
            title: Create owned Monaco models
            body: Each editor gets a dedicated `bygone://model` URI so comparisons can swap content and language without leaking stale models.
            focus: owned-monaco-model
            connection: models-to-host
          - id: enable-editor-affordances
            title: Enable familiar editor affordances
            body: Editor construction turns on folding, multi-cursor, drag-and-drop, bracket guides, and the native context menu.
            focus: editor-comfort-options
          - id: redraw-after-folding
            title: Redraw connectors after folding
            body: Hidden-area changes schedule connector redraws so folded regions do not leave stale diff links on screen.
            focus: folding-connectors
            connection: folding-to-connectors
          - id: navigate-changes-with-f7
            title: Navigate changes with F7
            body: F7, Shift+F7, and Cmd/Ctrl+Shift+Up/Down move between semantic changes while Alt+Up/Down remain available to Monaco.
            focus: change-navigation-keys
          - id: expose-selection-menu
            title: Expose a Selection menu
            body: Standalone builds add a Selection submenu of allowlisted cursor and smart-select actions routed through the renderer bridge.
            focus: selection-menu
            connection: menus-to-bridge
          - id: expose-lines-menu
            title: Expose a Lines menu
            body: A Lines submenu exposes line moves, joins, and indentation actions using the same allowlisted bridge.
            focus: lines-menu
          - id: bridge-menu-actions
            title: Bridge menu actions into Monaco
            body: The renderer handles `editorAction` host messages and runs the requested Monaco command in the active editor.
            focus: editor-action-bridge
          - id: prove-editor-comfort
            title: Prove the editing contract
            body: Regression tests require bundled contributions, owned models, Selection and Lines menus, `.bygone` syntax mapping, and F7 navigation.
            focus: editor-comfort-proof
            connection: comfort-to-proof

  - id: release-polish
    title: Release polish around platform behavior
    scenes:
      - id: platform-and-packaging
        title: Clarify platform opening and preserve npm routing
        summary: Alongside the editor work, 0.8.1 clarifies macOS-only `.bygone` opening, documents the platform split, preserves the npm CLI mapping, and advertises the new navigation shortcuts in tooltips.
        bullets:
          - README and docs state the macOS Finder path and other-platform fallbacks.
          - npm packaging keeps the `bygone` bin mapping stable.
          - Toolbar tooltips document F7 navigation instead of obsolete Alt-arrow shortcuts.
        tags: [documentation, packaging, tooltips]
        takeaway: The release documents how tours open on each platform and keeps install surfaces aligned with the new editor shortcuts.
        steps:
          - id: document-platform-split
            title: Document platform opening behavior
            body: The README explains that only packaged macOS builds register `.bygone` with Finder while other platforms require Bygone or the CLI.
            focus: readme-platform-split
          - id: preserve-npm-cli
            title: Preserve the npm CLI mapping
            body: Release packaging keeps the published `bygone` bin path relative so npm installs still expose the launcher correctly.
            focus: npm-cli-mapping
          - id: clarify-navigation-tooltips
            title: Clarify navigation tooltips
            body: Static button tooltips now advertise F7 and Cmd/Ctrl+Shift+Up/Down for change navigation and no longer claim Alt-arrow diff shortcuts.
            focus: tooltip-proof
            connection: keys-to-tooltips
