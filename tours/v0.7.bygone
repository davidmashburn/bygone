    revision: head
    contains: |-
      export function buildMultiDirectoryComparison(dirs: string[]): DirectoryEntry[] {
          const entries: DirectoryEntry[] = [];
          collectUnionEntries(dirs, '', 0, entries);
          return entries;
      }
  merge-base-boundary:
