+    }
+    if (
+        candidate.includes('\\')
+        || candidate.includes('\0')
+        || candidate.includes('\r')
+        || candidate.includes('\n')
+    ) {
+        throw new Error(`Workspace history path must be a safe relative path: ${value}`);
+    }
