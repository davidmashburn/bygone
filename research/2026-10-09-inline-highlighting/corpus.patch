+    try {
+        headOid = resolveCommitRevision(worktreeRoot, 'HEAD');
+    } catch (error) {
+        throw new Error(
+            `Repository ${worktreeRoot} has an unborn HEAD (no commit yet): ${errorMessage(error)}`
+        );
+    }
