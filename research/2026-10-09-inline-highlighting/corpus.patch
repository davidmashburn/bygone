+
+function readBoundedFile(filePath: string): BoundedFileRead {
+    let descriptor: number;
+    try {
+        descriptor = fs.openSync(filePath, 'r');
+    } catch {
+        return { kind: 'missing' };
+    }
+    try {
+        const stat = fs.fstatSync(descriptor);
