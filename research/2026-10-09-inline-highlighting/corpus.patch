+
+function buildReadyDescriptor(
+    repository: RepositoryInfo,
+    operands: readonly LocalOperand[],
+    revisions: string[] | WorkspaceGitUnavailable,
+    options: WorkspaceGitOptions,
+    sourceKind: WorkspaceGitSource['kind']
