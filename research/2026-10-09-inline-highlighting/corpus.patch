+        kind: 'ready',
+        repoRoot: repository.repoRoot,
+        commonDir: repository.commonDir,
+        worktreeRoot: repository.worktreeRoot,
+        paths,
+        revisions: [...revisions],
+        headOid,
+        activeRevision,
+        historyLabel
