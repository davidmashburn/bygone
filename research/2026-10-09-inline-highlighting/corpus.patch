+
+function readCommitMetadataBatch(
+    repoRoot: string,
+    selectedRoots: readonly string[],
+    axis: readonly string[]
+): CommitMetadata[] {
+    const output = runGitText([
+        'log',
+        '--topo-order',
+        '--reverse',
+        '--format=%H%x00%h%x00%cI%x00%s%x00%P%x1e',
+        ...selectedRoots.slice().sort()
