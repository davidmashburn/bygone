+
+function readLocalOperands(
+    source: Extract<WorkspaceGitSource, { kind: 'files' | 'directories' }>,
+    kind: 'files' | 'directories'
+): LocalOperand[] {
+    if (!Array.isArray(source.paths)) {
+        throw new Error(`The ${kind} source paths value is not an array.`);
+    }
